# Copy this file to .env and fill in your MongoDB Atlas connection string.
# Atlas -> Database -> Connect -> Drivers. Add the database name (breast_cancer) after ".net/".
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/breast_cancer?retryWrites=true&w=majority&serverSelectionTimeoutMS=5000

# Optional overrides
# MODEL_PATH=../ML-Service/weights/model.onnx
# SERVER_PORT=8081
# CORS_ORIGINS=http://localhost:5173
