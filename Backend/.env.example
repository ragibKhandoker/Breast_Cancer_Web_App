# Copy this file to .env and fill in the values. .env is git-ignored; never commit real secrets.

# MongoDB Atlas -> Database -> Connect -> Drivers. Put the database name (breast_cancer) after ".net/".
# <user>/<password> are the Atlas *database user* (Database Access), not your Atlas login.
# URL-encode special characters in the password (for example @ becomes %40).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/breast_cancer?retryWrites=true&w=majority&serverSelectionTimeoutMS=5000

# Signs login tokens. Required, at least 32 characters. Generate one with:
#   PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
#   or: openssl rand -base64 48
JWT_SECRET=<long-random-secret>

# Optional: create the first administrator on startup (only if no account has this email yet).
# Password: 8-72 characters with upper-case, lower-case and a number. Remove it from .env once the account exists.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=<strong-password>
# ADMIN_FULL_NAME=Administrator

# Optional overrides
# JWT_TTL=PT2H                 # how long a login lasts (ISO-8601 duration)
# AUTH_COOKIE_SECURE=true      # set to true when the site is served over HTTPS
# MODEL_PATH=../ML-Service/weights/model.onnx
# SERVER_PORT=8081
# CORS_ORIGINS=http://localhost:5173

# F20 encrypted backups (docs/F20_AUDIT_BLOCKCHAIN_BACKUP_PRIVACY.md). Without the key no backup is written.
# Make one with:  [Convert]::ToBase64String((1..32 | % { [byte](Get-Random -Max 256) }))   (PowerShell)
#             or:  openssl rand -base64 32
# Keep a copy of the key somewhere safe and separate: backups cannot be read without it.
# BACKUP_ENCRYPTION_KEY=<32 random bytes, base64>
# BACKUP_DIR=../backups                 # outside the website's files; never commit it
# BACKUP_SCHEDULE=0 0 2 * * *           # cron in UTC (02:00 daily); "-" = off
# BACKUP_RETENTION_ENABLED=true
# BACKUP_RETENTION_DAILY=7
# BACKUP_RETENTION_WEEKLY=4
# BACKUP_RETENTION_MONTHLY=3
# BACKUP_RESTORE_ENABLED=false          # true only on a test server: restore tests write <db>_restore_test

# F20 blockchain proofs of audit events: a private/test Ethereum node only (Hardhat, Anvil, Ganache, private Geth/Besu).
# AUDIT_BLOCKCHAIN_ENABLED=true
# AUDIT_BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
# AUDIT_BLOCKCHAIN_ACCOUNT=0x...        # an account the node has unlocked; this app holds no private key
# AUDIT_BLOCKCHAIN_NETWORK=hardhat-local
# AUDIT_BLOCKCHAIN_CONTRACT=0x...      # AuditIntegrity address printed by blockchain/scripts/deploy.js (optional)
# AUDIT_BLOCKCHAIN_POLL_INTERVAL=PT30S
