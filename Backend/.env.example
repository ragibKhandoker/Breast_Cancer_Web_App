# Copy this file to .env and fill in the values. .env is git-ignored; never commit real secrets.

# MongoDB Atlas -> Database -> Connect -> Drivers. Put the database name (breast_cancer) after ".net/".
# <user>/<password> are the Atlas *database user* (Database Access), not your Atlas login.
# URL-encode special characters in the password (for example @ becomes %40).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/breast_cancer?retryWrites=true&w=majority&serverSelectionTimeoutMS=5000

# Signs login tokens. Required, at least 32 characters. Generate one with:
#   PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
#   or: openssl rand -base64 48
JWT_SECRET=<long-random-secret>

# Optional: create the first administrator on startup (only if no account has this email yet).
# Password: 8-72 characters with upper-case, lower-case and a number. Remove it from .env once the account exists.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=<strong-password>
# ADMIN_FULL_NAME=Administrator

# Optional overrides
# JWT_TTL=PT2H                 # how long a login lasts (ISO-8601 duration)
# AUTH_COOKIE_SECURE=true      # set to true when the site is served over HTTPS
# MODEL_PATH=../ML-Service/weights/model.onnx
# SERVER_PORT=8081
# CORS_ORIGINS=http://localhost:5173
